# Server Configuration
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000/api/v1
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_scheduler

# Redis Configuration (Required for BullMQ & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch Configuration (Search Indexing)
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# Concurrency & Rate Limiting (Configurable as required)
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# Ethereal SMTP (If left blank, auto-generates test credentials on startup)
ETHEREAL_USER=
ETHEREAL_PASS=

# Google OAuth 2.0 (For Login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
JWT_SECRET=super-secret-jwt-key-reachinbox-scheduler-2026

# Slack OAuth 2.0 (For Rate Limit Alerts)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/v1/slack/oauth/callback
SLACK_WEBHOOK_URL=
